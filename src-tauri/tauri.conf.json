{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varde",
  "version": "0.1.0",
  "identifier": "io.github.bardoelt.varde",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Varde",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    },
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MjExMUNERTQ3MUQzM0IKUldRNzAzSGt6UkVoTlVMWElpWU1MOVRXRUNhVUk1dERCRmZOWUZYUGo4MlZPUG8xaWJya0lWclcK",
      "endpoints": ["https://github.com/BardoelT/varde/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
